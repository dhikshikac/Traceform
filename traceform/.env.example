# Copy this file to .env and fill in ONE option. .env is git-ignored; never commit a key.
# Without a .env the app still runs; AI features show "AI offline".

# --- Free: Google Gemini (recommended for the MVP) --------------------------------
# Get a free key at https://aistudio.google.com/apikey (any Google account). No card needed.
# The free tier has per-minute limits, which is fine for one person demoing.
AI_PROVIDER=openai
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=paste-your-gemini-key-here
AI_MODEL=gemini-flash-lite-latest

# --- Photos -----------------------------------------------------------------------
# Site photography is SEARCHED, never generated. Openverse (Creative Commons) is the
# default and needs no key. To use Unsplash instead, uncomment both lines:
# PHOTO_PROVIDER=unsplash
# UNSPLASH_ACCESS_KEY=...

# --- Paid: Anthropic ------------------------------------------------------------------
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Any other OpenAI-compatible API (OpenAI, Groq, OpenRouter...) ----------------
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=...
# AI_MODEL=...
